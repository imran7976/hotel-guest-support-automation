# ==============================================================================
# AI-Powered Hotel Guest Support Automation System - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Powered Hotel Guest Support Automation System"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-ultra-secure-secret-key-in-production-hotel-guest-2025
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend & CORS Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration (MySQL 8 Default, SQLite supported for local development)
# For MySQL: mysql+pymysql://hotel_user:hotel_password@localhost:3306/hotel_guest_support
# For SQLite (local testing): sqlite:///./hotel_support.db
DATABASE_URL=sqlite:///./hotel_support.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_guest_support
MYSQL_USER=hotel_user
MYSQL_PASSWORD=hotel_secure_pass_2025
MYSQL_ROOT_PASSWORD=hotel_root_secure_pass_2025

# OpenAI API Settings
# The system supports any modern OpenAI model (e.g. gpt-4o, gpt-4o-mini, gpt-3.5-turbo).
# If OPENAI_API_KEY is not provided, system falls back to an intelligent local rule-based AI engine for DEMO/offline testing.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.75
AI_TEMPERATURE=0.2

# n8n Workflow Automation Settings
N8N_WEBHOOK_URL_BASE=http://localhost:5678/webhook
N8N_WEBHOOK_AUTH_TOKEN=hotel_n8n_secure_token_xyz987
N8N_ENABLED=true

# Notification & Email (Safe DEMO Mode)
# MOCK_DELIVERY=true ensures notifications are logged and stored in DB, never sent to external recipients unless configured.
MOCK_DELIVERY=true
SUPPORT_TEAM_EMAIL=support@grandhotelazure.demo
HOTEL_FRONTDESK_PHONE=+1-555-0199

# Default Admin Credentials (Auto-seeded on initial start)
ADMIN_DEFAULT_EMAIL=admin@grandhotelazure.demo
ADMIN_DEFAULT_PASSWORD=AdminHotel2025!
ADMIN_DEFAULT_NAME="Front Office Manager"

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_HOTEL_NAME="Grand Azure Resort & Hotel"

